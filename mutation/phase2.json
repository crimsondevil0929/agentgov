  "equivalent": {
    "src/agentgov/core.py::Ledger._adopt::assign::remove `self._legacy_auth_ids = {}`": "Every open from a store assigns the legacy ids afresh from its authorization rows right after (_adopt_authorizations); _rewind adopts for a ledger with no store, which has none.",
    "src/agentgov/core.py::Ledger._commit::if-false::`if not batch` -> never": "An empty unit of work commits nothing either way: the store writes no row and the view merges no change. A round trip, not a behavior.",
    "src/agentgov/core.py::Ledger._commit::if-true::`if audit_log.isEnabledFor(logging.INFO)` -> always": "Formatting lines for a logger nothing listens to writes nothing: a cost, not a behavior.",
    "src/agentgov/core.py::Ledger._follow_holds::call::remove `self._legacy_auth_ids.pop(hold_id, None)`": "A closed hold is never looked up again (_authorization_id serves holds being closed), and the map holds only the pre-0.4 authorizations open at the open: a bounded set kept a little longer.",
    "src/agentgov/core.py::_Overlay._begin_transaction::if-true::`if self._txn is not None` -> always": "_txn is None only before the first entry and after end_transaction, when nothing is staged: ending the transaction then is a no-op.",
    "src/agentgov/core.py::_Overlay._writable::if-false::`if current is None` -> never": "Unreachable: the one caller (a funding) stages a scope only after node() found it; a missing node would fail anyway, in dataclasses.replace.",
    "src/agentgov/core.py::_Overlay._writable::raise::remove `raise LedgerIntegrityError(f'scope {scope_id!r} is not in the chain...`": "Unreachable: the one caller (a funding) stages a scope only after node() found it; a missing node would fail anyway, in dataclasses.replace.",
    "src/agentgov/core.py::_Overlay.apply::if-true::`if check_hash` -> always": "check_hash is off only for entries this process built a moment ago, whose hashes are right by construction: recomputing them costs time and finds nothing.",
    "src/agentgov/core.py::_Overlay.end_transaction::assign::remove `self._txn = None`": "The next entry either opens another transaction, ending this one a second time with nothing staged (a no-op), or names the same id, which then continues with nothing staged, as a fresh transaction would.",
    "src/agentgov/core.py::_Overlay.trip_of::if-false::`if scope_id in self._tripped` -> never": "No unit of work stages a breaker change and then asks about it: _stage_trip, the one caller on a view, runs once per unit (a settlement either overdraws or exhausts), and a trip or reset commits alone.",
    "src/agentgov/core.py::_Overlay.trip_of::return::`return self._tripped[scope_id]` -> `return None`": "No unit of work stages a breaker change and then asks about it: _stage_trip, the one caller on a view, runs once per unit (a settlement either overdraws or exhausts), and a trip or reset commits alone.",
    "src/agentgov/core.py::_Pending.post::compare::< -> <= in `now < view.last_timestamp`#0": "When the clock reads the newest entry's time exactly, the entry is dated that time either way.",
    "src/agentgov/core.py::_Pending.post::constant::False -> True::2": "Recomputing the hash of an entry built a moment ago finds what was just computed: a cost, not a behavior.",
    "src/agentgov/core.py::_Pending.post::constant::True -> False::3": "Every entry written is AGOV3 (_AUDIT_VERSION), and the rules held to new writes cover every AGOV3 entry already; writing=True says so for a later format.",
    "src/agentgov/core.py::_Pending.post::if-true::`if line.direction is Direction.DEBIT` -> always": "Only zero-value types take Direction.NONE, so the line's amount is 0: negating it leaves every balance as it is.",
    "src/agentgov/core.py::_coerce::if-true::`if not isinstance(value, Decimal)` -> always": "Decimal(d) of a Decimal is d's exact value: no context rounds it, so the conversion changes nothing.",
    "src/agentgov/core.py::_replay::if-true::`if finish` -> always": "finish=False only replays a chain whose pre-0.1.2 events the seal folds in (or that has none): an unsealed pre-0.1.2 chain is replayed so only for a writable open, whose first write is that seal, before anything reads the state."
  },
